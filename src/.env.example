# Copy to .env and fill in. Never commit .env. On Replit, put these in Tools > Secrets instead (see REPLIT_SETUP.md).
# 1. PostgreSQL connection string
DATABASE_URL=postgresql://nexora:change-me@localhost:5432/nexora

# 2. Clerk keys (Clerk dashboard -> your application -> API keys). Development keys start with pk_test_ / sk_test_.
CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
VITE_CLERK_PUBLISHABLE_KEY=pk_test_...

# 3. Optional: Himalayas API key (raises job-feed rate limits). Server only.
HIMALAYAS_API_KEY=

# 4. Optional: email for team invitations. Without these, nothing is emailed: the person who invites is shown a private
#    link to send themselves. With them, Nexora emails the invitation. Gmail example: SMTP_HOST=smtp.gmail.com,
#    SMTP_PORT=587, SMTP_USER=you@gmail.com, SMTP_PASS=<a Google "app password">, MAIL_FROM="Nexora <you@gmail.com>"
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
# Public address of the web app, used in the invitation link (no trailing slash). APP_BASE_PATH only if served under a sub-path.
APP_BASE_URL=http://localhost:5173
APP_BASE_PATH=

# 5. Optional: AI assistant (bottom-right "Help" button). Without any key it gives built-in quick answers about using Nexora only.
#    Option A, free tier available: Google Gemini. Get a key at https://aistudio.google.com/apikey (no card needed for the free tier).
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-flash-latest
#    Option B, paid: Anthropic Claude. If both keys are set, Claude is used unless AI_PROVIDER=gemini.
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-haiku-5-5
# AI_PROVIDER=gemini            # or anthropic; optional
#    Web search lets the assistant look things up online (Claude: allow it in the Anthropic Console, Settings > Privacy; Gemini: Google Search
#    grounding, which has its own free allowance). Set to off to disable.
# AI_WEB_SEARCH=on
